"pages": [
{
"id": "a81350af0baa4a419ae86451612e8566",
"title": "Queen of Mahjong",
"iframe": "https://html5.gamedistribution.com/a81350af0baa4a419ae86451612e8566/",
"description": "Match connecting Mahjong tiles across increasingly complex boards in this tile-matching puzzle game. Players aim to clear the layout by finding matching pairs linked by unobstructed paths, testing spatial reasoning and planning skills. The game blends traditional Mahjong patterns with progressive tile arrangements for added strategic depth.\n\nKey Features\n\n• Path-link matching mechanic  \n• Mouse-driven tile selection  \n• Level-based tile layout progression  \n• Time-limited challenge mode  \n• Classic Mahjong tile designs"
},
{
"id": "bb9d9c797133411385adc3b8e60e6583",
"title": "Empress Mahjong: Jade Palace",
"iframe": "https://html5.gamedistribution.com/bb9d9c797133411385adc3b8e60e6583/",
"description": "Match tiles strategically to clear the board in this classic mahjong setup featuring exquisite jade-themed pieces. Players uncover matching pairs to unlock new layers and progress through increasingly intricate layouts. The game offers a calm palace ambiance that guides casual gamers, teens, and kids through patterns challenging their observation and patience skills.\n\nKey Features\n\n• Tile matching puzzle mechanics  \n• Click-and-drag tile selection controls  \n• Layered board progression system  \n• Timed and untimed gameplay options  \n• Jade palace aesthetic elements"
},
